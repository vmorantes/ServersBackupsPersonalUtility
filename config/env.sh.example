#!/usr/bin/env bash
# =============================================================================
# env.sh — configuración por servidor
# =============================================================================
# Referencia de todas las variables que leen los scripts. Para dar de alta un
# servidor nuevo:
#
#   cp env.sh.example env.sh
#
# Los scripts no llevan nada específico de ninguna máquina: todo lo que cambia
# entre servidores vive aquí. Eso es lo que permite que el mismo script sirva
# sin modificaciones en todos.
# =============================================================================

# --- Generales ---------------------------------------------------------------
# Usuario de HestiaCP dueño de la instalación y de las salidas.
#
# OJO: NO es el usuario con el que se entra por SSH. En HestiaCP los usuarios
# del panel tienen shell 'nologin' y no pueden abrir consola. Para conectarse se
# usa DEPLOY_USER (root, más abajo).
export USER_NAME="admin"

# Raíz de la instalación. Los demás directorios cuelgan de aquí por defecto.
export SCRIPTS_DIR="/home/${USER_NAME}/scripts"

# --- Conexión a MySQL --------------------------------------------------------
export MYSQL_USER="CAMBIAR"
export MYSQL_PASS="CAMBIAR"

# Opcionales: déjalos vacíos para conectar por socket local.
export MYSQL_HOST=""
export MYSQL_PORT=""
export MYSQL_SOCKET=""

# Juego de caracteres del volcado. utf8mb4 evita que se corrompan emojis y
# caracteres multibyte si el cliente negocia latin1 por defecto. Cámbialo solo
# si el servidor es muy antiguo.
export MYSQL_CHARSET="utf8mb4"

# Bases de datos que nunca se respaldan (lista SQL, entre paréntesis).
export EXCLUDE_DBS="('information_schema','performance_schema','mysql','sys','phpmyadmin')"

# --- Rutas de salida ---------------------------------------------------------
export BACKUP_OUTPUT_DIR="${SCRIPTS_DIR}/output/mysql_backups"
export BACKUP_WORK_DIR="${SCRIPTS_DIR}/output"
export HESTIA_OUTPUT_DIR="${SCRIPTS_DIR}/output/HestiaCP"
export LOG_DIR="${SCRIPTS_DIR}/logs"

# --- Retención ---------------------------------------------------------------
# Sin esto los respaldos se acumulan sin límite (~40 MB diarios = 1,2 GB/mes) y
# el disco acaba llenándose, que es la forma más tonta de quedarse sin respaldo.
# 0 desactiva el borrado automático.
export BACKUP_RETENTION_DAYS="14"
export LOG_RETENTION_DAYS="30"
export RESTIC_RETENTION_DAYS="90"

# Red de seguridad: nunca borrar los N respaldos más recientes aunque superen la
# antigüedad máxima. Protege el caso de que el cron lleve semanas caído.
export BACKUP_KEEP_MIN="3"

# --- Comprobaciones ----------------------------------------------------------
# Espacio libre mínimo (MB) exigido antes de empezar. Mejor no empezar que
# llenar el disco a mitad del volcado y dejar un respaldo truncado.
export MIN_FREE_MB="2048"

# --- Avisos ante fallo (todos opcionales) ------------------------------------
# Un cron que falla en silencio es un respaldo que no existe. Configura al menos
# uno de estos tres.

# 1) Correo (requiere que 'mail' esté instalado y configurado):
export NOTIFY_EMAIL=""

# 2) Orden arbitraria. Recibe NOTIFY_SUBJECT y NOTIFY_BODY como variables de
#    entorno. Ejemplo con ntfy.sh:
#    export NOTIFY_COMMAND='curl -fsS -H "Title: $NOTIFY_SUBJECT" -d "$NOTIFY_BODY" https://ntfy.sh/mi-canal'
export NOTIFY_COMMAND=""

# 3) Healthcheck tipo healthchecks.io: ping a la URL al terminar bien y a
#    <URL>/fail si algo falló. Es el único de los tres que además detecta que el
#    cron dejó de ejecutarse, que es el fallo más silencioso de todos.
export HEALTHCHECK_URL=""

# --- HestiaCP ----------------------------------------------------------------
export HESTIA_DIR="/usr/local/hestia"

# Usuarios del panel cuyos respaldos interesan. Vacío = todos los que haya.
# Solo sirve para informar: v-backup-users-restic respalda todos.
export HESTIA_USERS=""

# --- Acceso al servidor ------------------------------------------------------
# DEPLOY_USER es QUIEN SE CONECTA por SSH; normalmente root, porque los usuarios
# de HestiaCP no tienen consola y las órdenes v-* exigen privilegios.
# USER_NAME, arriba, es de quién es la instalación. Pueden ser distintos: se
# entra como root y se instala en el home del usuario del panel.
export DEPLOY_HOST=""
export DEPLOY_USER="root"
export DEPLOY_PATH="/home/${USER_NAME}/scripts"
