{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "deny": [
      "Bash(sudo:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(sftp:*)",
      "Bash(sshpass:*)",
      "Bash(mysql:*)",
      "Bash(mysqldump:*)",
      "Bash(git push:*)",
      "Read(./*/env.sh)",
      "Read(./*/env.sh.anterior)",
      "Read(./*/env.sh.nuevo)",
      "Read(./*/output/HestiaCP/**)",
      "Read(./*/ESTADO.md)",
      "Read(./.git/config)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$CLAUDE_PROJECT_DIR/.agents/scripts/guardas/guardia.py\""
          }
        ]
      }
    ]
  }
}
